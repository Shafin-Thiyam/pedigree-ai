
# ==========================================
# Pedigree AI - .gitignore
# ==========================================

# Python virtual environments
.python-version
.venv/
venv/
env/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Python packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
test-results/
.tox/
.nox/
hypothesis/

# Type checking and linting
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Jupyter notebooks
.ipynb_checkpoints/

# Logs
*.log
logs/

# Database local files
*.db
*.sqlite
*.sqlite3
postgres_data/

# Alembic
# Keep migration scripts tracked in Git

# IDE settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini

# Node.js / React frontend
node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker local overrides
docker-compose.override.yml

# Generated pedigree files
exports/
generated/
output/
*.ged.tmp

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Local application storage
storage/
uploads/

# Do not ignore
# pyproject.toml
# .python-version
# README.md
# alembic/versions/
# frontend/package-lock.json
